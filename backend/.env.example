AI_BASE_URL=https://api.apiyi.com/v1
AI_API_KEY=
AI_MODEL=gpt-6-luna
AI_TIMEOUT_SEC=90

# 首次启动时用来创建唯一账户的密码
LEDGER_PASSWORD=change-me
# 请改成随机字符串，用于签发登录令牌
LEDGER_JWT_SECRET=please-change-this-secret
LEDGER_DATA_DIR=/data
LEDGER_TZ=Asia/Shanghai
LEDGER_TOKEN_DAYS=180

# 微信文字记账入口：独立使用 iLink，不需要安装 OpenClaw
WECHAT_ENABLED=1
# 可选。不填时在数据目录自动生成 wechat.key；升级与迁移时务必保留该文件
WECHAT_ENCRYPTION_KEY=
# 回复中附带的账本入口；子路径部署请包含 /jizhang
LEDGER_PUBLIC_URL=https://jizhang.clockwise.asia
